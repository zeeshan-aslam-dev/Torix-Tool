generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id                      Int           @id @default(autoincrement())

  /// Stable identity of one practice location: normalised org name + address.
  /// Imports upsert on this, so re-running never orphans a contact or an
  /// outreach record the way a delete-and-reinsert did.
  leadKey                 String?       @unique

  organization            String
  address                 String
  city                    String
  state                   String
  zip                     String
  npi                     String?
  taxonomy                String?
  n_locations_detected    Int           @default(0)
  n_providers_at_location Int           @default(0)

  // Straight from NPPES, captured during Step 1 so scoring and the dialer
  // do not need a second pass over the 11GB source file.
  entityType              String?       // "1" = individual provider, "2" = organization
  phone                   String?
  fax                     String?
  authorizedOfficialName  String?
  authorizedOfficialTitle String?
  authorizedOfficialPhone String?
  lastUpdateDate          DateTime?
  enumerationDate         DateTime?
  isSoleProprietor        String?
  isOrganizationSubpart   String?
  parentOrganizationLbn   String?

  /// A separate individual (Entity Type 1) NPI record for this same person,
  /// found by name+state during Step 1. Kept only as a fallback contact number
  /// — a personal NPI phone that differs from the practice's own listed number
  /// is a second way to reach the same decision maker, not a lead in itself.
  alternateOfficialPhone  String?
  alternateOfficialNpi    String?

  /// Time Zone > State > City > County — the grouping this was built for.
  /// County comes from a ZIP crosswalk (NPPES has none); time zone is
  /// state-level with overrides for the well-documented split counties.
  /// Neither is a live lookup — set once at Step 1 from the ZIP already on
  /// the row, so it costs nothing to reuse on every future query.
  county                  String?
  timezone                String?

  /// A name pulled from the practice's own website/contact page rather than
  /// asserted by NPPES — set only when Step 4 finds explicit ownership language
  /// ("Owner: ...", "founded by ...") near a name. Compared against
  /// authorizedOfficialName in the log, not auto-merged into it: NPPES stays
  /// the field of record unless a human decides the site is right and it is
  /// wrong.
  webOwnerName            String?
  webOwnerNameSource      String?       // which page it was found on

  tag                     String?       // HOT, VERIFY, EXCLUDE
  reason                  String?
  score                   Int           @default(0)
  scoredAt                DateTime?
  website_found           String?
  websiteSource           String?       // endpoint, guess, search, gbp
  websiteConfidence       Int?          // 0-100, how well the page matched the lead
  websiteCheckedAt        DateTime?
  // The business's own LinkedIn page — read out of Step 3's search results at no
  // extra cost, since linkedin.com is already fetched and then discarded as a
  // directory domain. Set only when found, same as possible_acquisition below.
  linkedinUrl             String?

  // Google Business Profile — the only source that reports whether a practice
  // has stopped trading, which NPPES never does.
  gbpPlaceId              String?
  gbpName                 String?
  gbpCategory             String?
  gbpRating               Float?
  gbpReviews              Int?
  gbpPhone                String?
  gbpWebsite              String?
  gbpStatus               String?       // OPERATIONAL, CLOSED_TEMPORARILY, CLOSED_PERMANENTLY
  gbpMatchConfidence      Int?          // 0-100, how sure we are it is the same business
  gbpCheckedAt            DateTime?
  /// Step 2's own read of the NPPES subpart/parent fields — recomputed, and so
  /// safe to overwrite, on every score run. Informational only; it never gates
  /// anything on its own.
  possible_acquisition    Boolean       @default(false)
  /// Set once by Step 3 when its own site or a search result stated the
  /// practice is "part of"/"acquired by" another organisation, and never reset
  /// by anything else — a page that later stops saying so does not undo the
  /// finding. Step 2 reads this back as a hard EXCLUDE gate. Keeping it in a
  /// field of its own, separate from possible_acquisition above, matters: that
  /// field is rewritten unconditionally on every score run, and a gate fed by
  /// a value the same step keeps overwriting would occasionally un-exclude a
  /// lead Step 3 had correctly flagged, for no reason a person watching would
  /// be able to see.
  webAcquisitionFlag      Boolean       @default(false)
  search_snippet          String?
  dbaNames                String?       // trade names from othername_pfile
  
  contact                 Contact?
  outreach                Outreach?
  logs                    ResponseLog[]

  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([state])
  @@index([tag])
  @@index([score])
  @@index([npi])
  @@index([city])
}

model Contact {
  id                    Int      @id @default(autoincrement())
  leadId                Int      @unique
  lead                  Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  decisionMakerName     String?
  decisionMakerTitle    String?
  decisionMakerEmail    String?
  decisionMakerLinkedIn String?
  decisionMakerPhone    String?
  emailSource           String?   // nppes, website
  emailConfidence       Int?      // 0-100
  emailVerifyStatus     String?   // ok, mx_ok, catch_all, unknown, invalid, disposable
  emailVerifiedAt       DateTime?
  contactCheckedAt      DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Outreach {
  id             Int      @id @default(autoincrement())
  leadId         Int      @unique
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  emailStatus    String?  @default("Not sent") // Not sent, Queued, Sent, Opened, Replied, Bounced
  emailCampaign  String?   // Instantly campaign id, or the export batch that carried it
  exportedAt     DateTime?
  emailDate      DateTime?
  linkedInStatus String?  @default("Not sent") // Not sent, Sent, Seen, Replied
  linkedInDate   DateTime?
  callStatus     String?  @default("Not called") // Not called, Attempted, Reached, Gatekeeper, No answer
  callDate       DateTime?
  voicemailStatus String? @default("Not sent") // Not sent, Sent, Callback
  voicemailDate  DateTime?
  
  pipelineStage  String   @default("New") // New, Contacted, Responded, Meeting Booked, Proposal Sent, Won, Lost
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ResponseLog {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel   String   // Email, Call, LinkedIn, Note
  content   String
  date      DateTime @default(now())
}

model Client {
  id                  Int      @id @default(autoincrement())
  organization        String
  contractStartDate   DateTime?
  billingTerms        String?
  amountBilled        Float    @default(0.0)
  amountPaid          Float    @default(0.0)
  outstandingBalance  Float    @default(0.0)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}


/// Permanent record of practices and addresses that have already been contacted.
///
/// Deliberately holds no relation to Lead: a re-import, a reset, even a dropped
/// database table must not be able to erase the fact that someone was mailed.
/// The send step checks this before every push.
model Suppression {
  id        Int      @id @default(autoincrement())
  kind      String   // email | practice
  value     String   // lowercased address, or the lead's leadKey
  reason    String   // sent | queued | bounced | unsubscribed | manual
  note      String?
  firstSeen DateTime @default(now())
  lastSeen  DateTime @updatedAt

  @@unique([kind, value])
  @@index([kind])
}
