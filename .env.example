# Copy to .env and fill in. .env is gitignored — never commit real keys.

DATABASE_URL="file:./dev.db"

# Step 3 — website lookup, and the optional Google Business Profile lookup.
# Without one of these the step runs free sources only.
# Serper sells credits that do not expire; SerpAPI sells a monthly allowance that
# does. Resolution is bursty, so Serper is preferred and wins when both are set.
SERPER_KEY=
SERPAPI_KEY=

# Step 4 — email verification. Without it, Step 4 still checks syntax and MX
# records, which is free and rejects dead domains on its own.
MILLIONVERIFIER_KEY=

# Step 4 — decision-maker enrichment. Not wired up yet.
APOLLO_API_KEY=

# Step 5 — sending. Both are required for API mode; without them Step 5 exports CSV.
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=

# Optional. MX lookups go to these resolvers because a machine's own resolver is
# often a stub that refuses record queries. Comma-separated.
DNS_SERVERS=

# Extra folder(s) to read NPPES CSVs from, so the multi-GB dissemination folder
# does not have to be copied into the project. Use forward slashes; separate
# multiple folders with a semicolon.
NPPES_DATA_DIR=""
