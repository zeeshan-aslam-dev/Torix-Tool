# Copy to .env and fill in. .env is gitignored — never commit real keys.

DATABASE_URL="file:./dev.db"

# Step 3 — website lookup. Without this the step falls back to free sources only.
SERPAPI_KEY=

# Step 4 — decision-maker enrichment.
APOLLO_API_KEY=

# Step 5 — sending. Both are required for API mode; without them Step 5 exports CSV.
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=

# Extra folder(s) to read NPPES CSVs from, so the multi-GB dissemination folder
# does not have to be copied into the project. Use forward slashes; separate
# multiple folders with a semicolon.
NPPES_DATA_DIR=""
